# --- Web (build-time, Vite) ---
# URL da API. Em desenvolvimento aponte para o servidor Express local.
VITE_API_URL=http://localhost:3001

# --- API (server/index.js) ---
# Postgres: local via docker-compose.local.yml, ou a connection string do Neon.
DATABASE_URL=postgres://trampo:trampo_local_dev@localhost:55433/trampo

# Segredo de assinatura dos tokens. Em producao o processo aborta se faltar.
# Gere: node -e "console.log(require(0,\"crypto\").randomBytes(32).toString(\"hex\"))"
JWT_SECRET=troque-por-um-valor-aleatorio

# Origens liberadas no CORS, separadas por virgula. Vazio = qualquer origem.
ALLOWED_ORIGINS=https://trampo-hazel.vercel.app

NODE_ENV=development
PORT=3001

# --- Mobile (pasta mobile/, build-time do Expo) ---
# Sem esta variavel o app deriva o IP da LAN pelo host do Metro.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3001
